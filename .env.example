# Crear el archivo real con: npm run setup -- --user demo
HOST=127.0.0.1
PORT=8093
PUBLIC_ORIGIN=http://127.0.0.1:8093
NODE_ENV=development
COOKIE_SECURE=false
SESSION_HOURS=8
LOGIN_USER=demo
# El asistente de configuración genera un hash scrypt. No poner contraseña en texto.
LOGIN_PASSWORD_HASH=generar_con_npm_run_setup
